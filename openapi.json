{
  "openapi": "3.0.3",
  "info": {
    "title": "ГИС ЕКС — API для внешних сервисов",
    "description": "Спецификация открытого интерфейса информационного взаимодействия (API) ГИС «Единая карта сахалинца» (ГИС ЕКС) с внешними системами. Версия документа: от 24.04.2025. Оператор ГИС ЕКС: ГКУ СО «ЦРЦТ».",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://10.4.6.1:8082/outerApi",
      "description": "Стенд ГИС ЕКС (базовый префикс /outerApi)"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    { "name": "Пользователи", "description": "Сервисы работы с данными пользователя" },
    { "name": "Заявления и карты", "description": "Сервисы подключения и управления картами ЕКС" },
    { "name": "Настройки", "description": "Сервисы актуализации учетных данных" },
    { "name": "Библиотека", "description": "Сервисы работы с читательским билетом" }
  ],
  "paths": {
    "/user/identify": {
      "post": {
        "tags": ["Пользователи"],
        "summary": "userIdentify — Проверка существования зарегистрированного пользователя",
        "description": "Проверка на основании персональных данных, зарегистрирован ли гражданин в ГИС ЕКС в качестве пользователя, и передача его уникального идентификатора во внешние системы.",
        "operationId": "userIdentify",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserIdentifyRequest" },
              "example": {
                "birthDate": "02.04.1999",
                "snils": "80145145962"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешная обработка запроса",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserIdentifyResponse" },
                "example": { "persId": "380190117" }
              }
            }
          },
          "400": {
            "description": "Не передан обязательный параметр запроса"
          },
          "403": {
            "description": "Пользователь ГИС ЕКС с указанными данными не найден"
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых других ошибках сервиса)"
          }
        }
      }
    },
    "/user/profile/auth": {
      "post": {
        "tags": ["Пользователи"],
        "summary": "userProfile — Получение данных профиля пользователя",
        "description": "Передача персональных и иных данных пользователя, хранящихся в ГИС ЕКС, во внешние системы.",
        "operationId": "userProfile",
        "parameters": [
          {
            "name": "persId",
            "in": "query",
            "required": true,
            "description": "Уникальный идентификатор пользователя в ГИС ЕКС",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешная обработка запроса",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserProfileResponse" },
                "example": {
                  "persId": 396696586,
                  "cards": null,
                  "mainData": {
                    "lastName": "Уманова",
                    "firstName": "Виолета",
                    "middleName": "Сергеевна",
                    "gender": 0,
                    "birthDate": "22.07.2005",
                    "birthPlace": "Ноглики",
                    "snils": "574-021-514 63",
                    "citizenship": 1
                  },
                  "document": {
                    "docType": 1,
                    "series": "3333",
                    "number": "970009",
                    "issueDate": "19.11.1997",
                    "issuedBy": "УВД Ноглики",
                    "issueCode": "557-528"
                  },
                  "contacts": {
                    "regAddress": "693000, Южно-Сахалинск, Южно-Сахалинск, ул. Ленина, 80, 17",
                    "factAddress": "693000, Южно-Сахалинск, Южно-Сахалинск, ул. Пуркаева, 82, 22",
                    "mobilePhone": "+7 (488) 065-10-00",
                    "email": "ma20070@mail.com",
                    "emailAccept": true
                  }
                }
              }
            }
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых ошибках обработки)"
          }
        }
      }
    },
    "/user/profile/change": {
      "post": {
        "tags": ["Пользователи"],
        "summary": "changeProfile — Изменение данных профиля пользователя",
        "description": "Редактирование данных профиля пользователя ГИС ЕКС со стороны внешних систем. В теле запроса передаются только те данные, которые необходимо изменить.",
        "operationId": "changeProfile",
        "parameters": [
          {
            "name": "persId",
            "in": "query",
            "required": true,
            "description": "Идентификатор пользователя",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProfileChangeRequest" },
              "example": {
                "document": {
                  "docType": 1,
                  "series": "3333",
                  "number": "970009",
                  "issueDate": "19.11.1997",
                  "issuedBy": "УВД Ноглики",
                  "issueCode": "557-528"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Успешная обработка запроса"
          },
          "404": {
            "description": "Пользователь с указанным идентификатором не найден"
          },
          "416": {
            "description": "Переданы недопустимые значения, не соответствующие регламенту взаимодействия (невалидные значения в параметрах тела запроса)"
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых ошибках обработки)"
          }
        }
      }
    },
    "/claims/create": {
      "post": {
        "tags": ["Заявления и карты"],
        "summary": "claimsCreate — Создание заявления на подключение карты",
        "description": "Передача заявления на подключение карты в качестве ЕКС со стороны внешних систем.",
        "operationId": "claimsCreate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Claim" },
              "example": {
                "cardInfo": {
                  "cardNumber": "2200380143517817",
                  "dateTo": "07/29"
                },
                "mainData": {
                  "lastName": "Уманова",
                  "firstName": "Виолета",
                  "middleName": "Сергеевна",
                  "gender": 0,
                  "birthDate": "22.07.2005",
                  "birthPlace": "Ноглики",
                  "snils": "57402151463",
                  "citizenship": 1
                },
                "document": {
                  "docType": 1,
                  "series": "3333",
                  "number": "970009",
                  "issueDate": "19.11.1997",
                  "issuedBy": "УВД Ноглики",
                  "issueCode": "557-528"
                },
                "contacts": {
                  "regAddress": "693000, Южно-Сахалинск, Южно-Сахалинск, ул. Ленина, 80, 17",
                  "factAddress": "693000, Южно-Сахалинск, Южно-Сахалинск, ул. Пуркаева, 82, 22",
                  "mobilePhone": "+7 (488) 065-10-00",
                  "email": "ma20070@mail.com",
                  "emailAccept": true
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешная обработка запроса",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ClaimResponse" },
                "example": {
                  "formNumber": "E-30072024-3",
                  "persId": "396725279",
                  "qrData": "9643100422172259841",
                  "bskNum": "4A405E5537C327696F3D8CB5C83B77DE1607EB29"
                }
              }
            }
          },
          "403": {
            "description": "У пользователя уже есть карта, которая используется в качестве Единой карты жителя"
          },
          "409": {
            "description": "Данный запрос уже обрабатывается (повторный запрос на регистрацию карты для одного пользователя)"
          },
          "410": {
            "description": "Номер СНИЛС уже используется"
          },
          "416": {
            "description": "Переданы недопустимые значения, несоответствующие регламенту взаимодействия (в параметрах gender, citizenship)"
          },
          "422": {
            "description": "Карта уже используется в качестве Единой карты жителя (карта привязана к другому пользователю ГИС ЕКС)"
          },
          "431": {
            "description": "Некорректный адрес регистрации и (или) пользователь не зарегистрирован или не проживает в Сахалинской области"
          },
          "451": {
            "description": "Номер не подходит по формату номеров карт ПС «Мир» (номер карты не проходит валидацию)"
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых ошибках обработки)"
          }
        }
      }
    },
    "/user/cards/list/{persId}": {
      "get": {
        "tags": ["Заявления и карты"],
        "summary": "cardsList — Получение списка карт",
        "description": "Передача данных о всех картах, когда-либо зарегистрированных в качестве ЕКС конкретным пользователем.",
        "operationId": "cardsList",
        "parameters": [
          {
            "name": "persId",
            "in": "path",
            "required": true,
            "description": "Идентификатор пользователя",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешная обработка запроса. Возвращается массив данных о картах.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/CardData" }
                },
                "example": [
                  {
                    "cardNumber": "2048",
                    "qrData": "9643100422172259841",
                    "bskNum": "4A405E5537C327696F3D8CB5C83B77DE1607EB29",
                    "status": 5,
                    "comment": "Единая карта Сахалинца активна",
                    "modifiedDate": "30.07.2024",
                    "bankBik": "044525111",
                    "connectType": "e",
                    "integrationStatus": {
                      "loyalty": 2,
                      "transport": 2,
                      "culture": 2
                    }
                  }
                ]
              }
            }
          },
          "403": {
            "description": "Данные пользователя не найдены (пользователь с указанным идентификатором не зарегистрирован в ГИС ЕКС)"
          },
          "404": {
            "description": "Пользователь не имеет Единых карт Сахалинца (пользователь зарегистрирован в ГИС ЕКС, но у него нет карт/заявлений)"
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых других ошибках обработки)"
          }
        }
      }
    },
    "/claims/cardNumber/check/{cardNumber}": {
      "get": {
        "tags": ["Заявления и карты"],
        "summary": "checkCardNumber — Проверка возможности подключения карты",
        "description": "Проверка разрешения на подключение конкретной банковской карты в качестве ЕКС.",
        "operationId": "checkCardNumber",
        "parameters": [
          {
            "name": "cardNumber",
            "in": "path",
            "required": true,
            "description": "Номер банковской карты",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": {
            "description": "Действующей карты с таким номером не найдено (успешная обработка запроса)"
          },
          "403": {
            "description": "Карта заблокирована банком, подключение невозможно (status=6)"
          },
          "410": {
            "description": "Карта уже использовалась в качестве ЕКС, повторное подключение данной карты невозможно (status=9)"
          },
          "422": {
            "description": "Карта уже используется в качестве ЕКС (при проверке действующей ЕКС, status=4/5)"
          },
          "451": {
            "description": "Карта должна быть выпущена одним из банков-партнеров проекта «Единая карта сахалинца»"
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых ошибках обработки)"
          }
        }
      }
    },
    "/claims/cards/checkActive/{persId}": {
      "get": {
        "tags": ["Заявления и карты"],
        "summary": "checkActive — Проверка наличия у пользователя активной ЕКС",
        "description": "Проверка наличия или отсутствия активных ЕКС у конкретного пользователя.",
        "operationId": "checkActive",
        "parameters": [
          {
            "name": "persId",
            "in": "path",
            "required": true,
            "description": "Идентификатор пользователя",
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "204": {
            "description": "Нет активных карт (успешная обработка запроса)"
          },
          "422": {
            "description": "Найдена активная карта (у пользователя есть активная ЕКС)"
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых других ошибках сервиса)"
          }
        }
      }
    },
    "/claims/cards/statusChange": {
      "post": {
        "tags": ["Заявления и карты"],
        "summary": "changeStatus — Изменение статуса (отключение) карт",
        "description": "Передача данных об изменении статуса (отключении) банковских карт со стороны внешних систем.",
        "operationId": "changeStatus",
        "parameters": [
          {
            "name": "bskNum",
            "in": "query",
            "required": true,
            "description": "Хэшированный номер карты",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "description": "Новый (присваиваемый) статус",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "204": {
            "description": "Статус успешно изменен (успешная обработка запроса)"
          },
          "403": {
            "description": "Невозможно отклонить подключение карты"
          },
          "406": {
            "description": "Изменение статуса не соответствует регламенту"
          },
          "410": {
            "description": "Невозможно заблокировать карту"
          },
          "418": {
            "description": "Для изменения статуса выпущенной банком карты обратитесь в Банк-эмитент"
          },
          "422": {
            "description": "Подключение новой карты невозможно. Для подключения другой карты «МИР» отключите текущую карту или отмените подключение, если карта находится в ожидании"
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых других ошибках сервиса)"
          }
        }
      }
    },
    "/user/settings/save": {
      "post": {
        "tags": ["Настройки"],
        "summary": "saveSettings — Изменение (актуализация) учетных данных",
        "description": "Актуализация учетных данных пользователя со стороны внешних систем.",
        "operationId": "saveSettings",
        "parameters": [
          {
            "name": "persId",
            "in": "query",
            "required": true,
            "description": "Идентификатор пользователя",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SaveSettingsRequest" },
              "example": {
                "mobilePhone": "+7 (556) 765-14-88",
                "email": "ma20070@mail.com",
                "emailAccept": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Выполнено (успешная обработка запроса)"
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых других ошибках сервиса)"
          }
        }
      }
    },
    "/user/barcode/{persId}": {
      "get": {
        "tags": ["Заявления и карты"],
        "summary": "getBarcode — Получение штрихкода активной ЕКС",
        "description": "Передача данных штрихового кода ЕКС, в котором закодирован уникальный идентификатор карты в Проекте.",
        "operationId": "getBarcode",
        "parameters": [
          {
            "name": "persId",
            "in": "path",
            "required": true,
            "description": "Идентификатор пользователя",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешная обработка запроса. Возвращается изображение штрихового кода.",
            "content": {
              "image/jpeg": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "403": {
            "description": "У пользователя нет активной карты"
          },
          "404": {
            "description": "Держатель с указанным идентификатором не найден"
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых других ошибках сервиса)"
          }
        }
      }
    },
    "/claims/cardNumber/checkIntegretionStatus/{bskNum}": {
      "get": {
        "tags": ["Заявления и карты"],
        "summary": "checkIntegrationStatus — Проверка статусов программ лояльности",
        "description": "Проверка активности льготных программ и программ лояльности (льготный проезд, «сахалинское долголетие», бонусная программа) у конкретной ЕКС. Примечание: в таблице сервисов метод указан как POST, в примере запроса используется GET.",
        "operationId": "checkIntegrationStatus",
        "parameters": [
          {
            "name": "bskNum",
            "in": "path",
            "required": true,
            "description": "Хэшированный номер карты",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешная обработка запроса",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IntegrationStatusResponce" },
                "example": {
                  "loyalty": 0,
                  "transport": 2,
                  "culture": 2
                }
              }
            }
          },
          "204": {
            "description": "Действующей карты с таким номером не найдено"
          },
          "500": {
            "description": "Ошибка обработки запроса (при любых других ошибках сервиса)"
          }
        }
      }
    },
    "/user/profile/transferConsent": {
      "post": {
        "tags": ["Пользователи"],
        "summary": "transferConsentRequest — Получение согласия на передачу данных",
        "description": "Получение согласия пользователя на передачу данных со стороны внешних систем.",
        "operationId": "transferConsentRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransferConsentRequest" },
              "example": {
                "birthDate": "11.10.2001",
                "snils": "67147146305",
                "transferConsent": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешная обработка запроса"
          },
          "403": {
            "description": "Пользователь с указанными данными не зарегистрирован в ГИС ЕКС"
          },
          "500": {
            "description": "Ошибка (при любых других ошибках сервиса)"
          }
        }
      }
    },
    "/bis/addReaders/{persId}": {
      "get": {
        "tags": ["Библиотека"],
        "summary": "addReaders — Подключение читательского билета",
        "description": "Подключение читательского билета к конкретной ЕКС.",
        "operationId": "addReaders",
        "parameters": [
          {
            "name": "persId",
            "in": "path",
            "required": true,
            "description": "Уникальный идентификатор пользователя ГИС ЕКС",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "202": {
            "description": "Успешная обработка запроса"
          },
          "402": {
            "description": "Билет уже подключен к ЕКС"
          },
          "403": {
            "description": "Карта не активна"
          },
          "404": {
            "description": "Пользователь не найден"
          },
          "405": {
            "description": "Найдено несколько записей с одинаковыми данными"
          },
          "500": {
            "description": "Ошибка (при любых других ошибках сервиса)"
          }
        }
      }
    },
    "/bis/readerStatus/{persId}": {
      "get": {
        "tags": ["Библиотека"],
        "summary": "readerStatus — Получение статуса читательского билета",
        "description": "Получение статуса и данных читательского билета пользователя.",
        "operationId": "readerStatus",
        "parameters": [
          {
            "name": "persId",
            "in": "path",
            "required": true,
            "description": "Уникальный идентификатор пользователя ГИС ЕКС",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Успешная обработка запроса",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReaderStatusResponse" },
                "example": {
                  "card": {
                    "bskNum": "string",
                    "lastNumbers": "string"
                  },
                  "dateOfFinish": "string",
                  "status": 0
                }
              }
            }
          },
          "404": {
            "description": "Пользователь не найден"
          },
          "405": {
            "description": "Читательский билет не подключен"
          },
          "500": {
            "description": "Ошибка (при любых других ошибках сервиса)"
          }
        }
      }
    },
    "/bis/shutdownReaders/{persId}": {
      "get": {
        "tags": ["Библиотека"],
        "summary": "shutdownReaders — Отключение читательского билета",
        "description": "Отмена привязки читательского билета и ЕКС.",
        "operationId": "shutdownReaders",
        "parameters": [
          {
            "name": "persId",
            "in": "path",
            "required": true,
            "description": "Уникальный идентификатор пользователя ГИС ЕКС",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "202": {
            "description": "Успешная обработка запроса"
          },
          "404": {
            "description": "Пользователь не найден"
          },
          "500": {
            "description": "Ошибка (при любых других ошибках сервиса)"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Basic-авторизация по параметрам доступа, выданным Оператором ГИС ЕКС (login:password)"
      }
    },
    "schemas": {
      "UserIdentifyRequest": {
        "type": "object",
        "required": ["snils", "birthDate"],
        "properties": {
          "snils": {
            "type": "string",
            "description": "СНИЛС"
          },
          "birthDate": {
            "type": "string",
            "description": "Дата рождения (ДД.ММ.ГГГГ)",
            "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$"
          }
        }
      },
      "UserIdentifyResponse": {
        "type": "object",
        "required": ["persId"],
        "properties": {
          "persId": {
            "type": "string",
            "description": "Уникальный идентификатор пользователя ГИС ЕКС"
          }
        }
      },
      "UserProfileResponse": {
        "type": "object",
        "description": "Данные профиля пользователя. Примечание: в документации поля mainData/document/contacts/cards описаны как массивы, но в примере ответа передаются одиночными объектами.",
        "properties": {
          "mainData": { "$ref": "#/components/schemas/ClaimMainData" },
          "document": { "$ref": "#/components/schemas/ClaimDocData" },
          "contacts": { "$ref": "#/components/schemas/ClaimContactData" },
          "cards": {
            "type": "array",
            "description": "Сведения о картах, подключенных к ГИС ЕКС",
            "items": { "$ref": "#/components/schemas/AuthCardInfo" }
          },
          "persId": {
            "type": "integer",
            "description": "Уникальный идентификатор пользователя в ГИС ЕКС"
          }
        }
      },
      "ClaimMainData": {
        "type": "object",
        "description": "Персональные данные пользователя",
        "required": ["snils", "birthDate", "firstName", "lastName"],
        "properties": {
          "snils": { "type": "string", "description": "СНИЛС" },
          "birthDate": {
            "type": "string",
            "description": "Дата рождения (ДД.ММ.ГГГГ)",
            "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$"
          },
          "birthPlace": { "type": "string", "description": "Место рождения" },
          "firstName": { "type": "string", "description": "Имя" },
          "middleName": { "type": "string", "description": "Отчество" },
          "lastName": { "type": "string", "description": "Фамилия" },
          "gender": {
            "type": "integer",
            "description": "Пол: 0 — женский, 1 — мужской",
            "enum": [0, 1]
          },
          "citizenship": {
            "description": "Гражданство: 1 — РФ, 2 — двойное, 3 — иное",
            "oneOf": [
              { "type": "string" },
              { "type": "integer", "enum": [1, 2, 3] }
            ]
          },
          "oms": { "type": "string", "description": "Номер полиса ОМС" }
        }
      },
      "ClaimDocData": {
        "type": "object",
        "description": "Данные документа, удостоверяющего личность",
        "required": ["docType", "number"],
        "properties": {
          "docType": { "type": "integer", "description": "Тип документа" },
          "number": { "type": "string", "description": "Номер" },
          "series": { "type": "string", "description": "Серия" },
          "issuedBy": { "type": "string", "description": "Кем выдан" },
          "issueDate": {
            "type": "string",
            "description": "Дата выдачи (ДД.ММ.ГГГГ)",
            "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$"
          },
          "issueCode": { "type": "string", "description": "Код подразделения" }
        }
      },
      "ClaimContactData": {
        "type": "object",
        "description": "Контактные данные",
        "properties": {
          "phone": { "type": "string", "description": "Номер телефона" },
          "mobilePhone": { "type": "string", "description": "Номер мобильного телефона" },
          "email": { "type": "string", "description": "Адрес электронной почты" },
          "emailAccept": { "type": "boolean", "description": "Флаг «Согласие на получение уведомлений»" },
          "regAddress": { "type": "string", "description": "Адрес регистрации" },
          "regAddressOktmo": { "type": "string", "description": "Код ОКТМО адреса регистрации" },
          "factAddress": { "type": "string", "description": "Адрес фактического проживания" },
          "factAddressOktmo": { "type": "string", "description": "Код ОКТМО адреса фактического проживания" }
        }
      },
      "AuthCardInfo": {
        "type": "object",
        "description": "Сведения о карте, подключенной к ГИС ЕКС",
        "properties": {
          "cardNumber": { "type": "string", "description": "Банковский номер карты" },
          "bskNum": { "type": "string", "description": "Хэшированный номер карты" },
          "bankBik": { "type": "string", "description": "БИК банка-эмитента карты" },
          "status": { "type": "integer", "description": "Статус карты" },
          "modifiedDate": {
            "type": "string",
            "description": "Дата последнего изменения (ДД.ММ.ГГГГ)",
            "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$"
          },
          "qrData": { "type": "string", "description": "Нефинансовый идентификатор карты" },
          "connectType": { "type": "string", "description": "Тип регистрации карты" },
          "comment": { "type": "string", "description": "Комментарий" },
          "integrationStatus": { "$ref": "#/components/schemas/IntegrationStatusResponce" }
        }
      },
      "IntegrationStatusResponce": {
        "type": "object",
        "description": "Данные об активности карты в программах лояльности",
        "properties": {
          "transport": { "type": "integer", "description": "Признак активности транспортной льготы" },
          "loyalty": { "type": "integer", "description": "Признак активности программы лояльности" },
          "culture": { "type": "integer", "description": "Признак активности «сахалинского долголетия»" }
        }
      },
      "ProfileChangeRequest": {
        "type": "object",
        "description": "Тело запроса изменения профиля. Передаются только те данные, которые необходимо изменить.",
        "properties": {
          "mainData": { "$ref": "#/components/schemas/ChangeMainData" },
          "document": { "$ref": "#/components/schemas/ClaimDocData" },
          "contacts": { "$ref": "#/components/schemas/ChangeContactData" }
        }
      },
      "ChangeMainData": {
        "type": "object",
        "description": "Персональные данные для изменения",
        "properties": {
          "birthPlace": { "type": "string", "description": "Место рождения" },
          "firstName": { "type": "string", "description": "Имя" },
          "middleName": { "type": "string", "description": "Отчество" },
          "lastName": { "type": "string", "description": "Фамилия" },
          "gender": {
            "type": "integer",
            "description": "Пол: 0 — женский, 1 — мужской",
            "enum": [0, 1]
          },
          "citizenship": {
            "description": "Гражданство: 1 — РФ, 2 — двойное, 3 — иное",
            "oneOf": [
              { "type": "string" },
              { "type": "integer", "enum": [1, 2, 3] }
            ]
          },
          "oms": { "type": "string", "description": "Номер полиса ОМС" }
        }
      },
      "ChangeContactData": {
        "type": "object",
        "description": "Контактные данные для изменения",
        "properties": {
          "phone": { "type": "string", "description": "Номер телефона" },
          "mobilePhone": { "type": "string", "description": "Номер мобильного телефона" },
          "email": { "type": "string", "description": "Адрес электронной почты" },
          "emailAccept": { "type": "boolean", "description": "Флаг «Согласие на получение уведомлений»" },
          "regAddress": { "$ref": "#/components/schemas/AddressDto" },
          "factAddress": { "$ref": "#/components/schemas/AddressDto" },
          "bankAccountNew": {
            "type": "string",
            "description": "Номер банковского счета",
            "maxLength": 20
          },
          "socialAggreement": {
            "type": "boolean",
            "description": "Согласие на перечисление социальных выплат на ЕКС"
          }
        }
      },
      "AddressDto": {
        "type": "object",
        "description": "Структурированный адрес",
        "properties": {
          "codeRegion": {
            "description": "Код региона: 65 — Сахалинская область, 99 — другой субъект РФ, 00 — за пределами РФ",
            "oneOf": [
              { "type": "string" },
              { "type": "integer", "enum": [0, 65, 99] }
            ]
          },
          "corpus": { "type": "string", "description": "Корпус" },
          "district": { "type": "string", "description": "Район" },
          "flat": { "type": "string", "description": "Квартира" },
          "house": { "type": "string", "description": "Дом" },
          "location": { "type": "string", "description": "Населенный пункт" },
          "region": { "type": "string", "description": "Регион" },
          "street": { "type": "string", "description": "Улица" },
          "structure": { "type": "string", "description": "Строение" },
          "foreign": { "type": "boolean", "description": "Флаг «Иностранный адрес»" },
          "index": { "type": "string", "description": "Почтовый индекс" }
        }
      },
      "CardInfo": {
        "type": "object",
        "description": "Данные подключаемой карты",
        "properties": {
          "cardNumber": { "type": "string", "description": "Банковский номер карты" },
          "bskNum": { "type": "string", "description": "Хэшированный номер карты" },
          "dateTo": { "type": "string", "description": "Срок действия карты (ММ/ГГ)" },
          "qrData": { "type": "string", "description": "Нефинансовый идентификатор карты" }
        }
      },
      "Claim": {
        "type": "object",
        "description": "Заявление на подключение карты",
        "required": ["cardInfo", "mainData"],
        "properties": {
          "cardInfo": { "$ref": "#/components/schemas/CardInfo" },
          "mainData": { "$ref": "#/components/schemas/ClaimMainData" },
          "document": { "$ref": "#/components/schemas/ClaimDocData" },
          "contacts": { "$ref": "#/components/schemas/ClaimContactData" }
        }
      },
      "ClaimResponse": {
        "type": "object",
        "description": "Ответ на создание заявления",
        "required": ["formNumber", "bskNum", "persId", "qrData"],
        "properties": {
          "formNumber": { "type": "string", "description": "Регистрационный номер заявления" },
          "bskNum": { "type": "string", "description": "Хэшированный номер карты" },
          "persId": { "type": "string", "description": "Идентификатор пользователя" },
          "qrData": { "type": "string", "description": "Нефинансовый идентификатор карты (QR)" }
        }
      },
      "CardData": {
        "type": "object",
        "description": "Данные о карте ЕКС",
        "properties": {
          "cardNumber": { "type": "string", "description": "Банковский номер карты" },
          "bskNum": { "type": "string", "description": "Хэшированный номер карты" },
          "bankBik": { "type": "string", "description": "БИК банка-эмитента карты" },
          "status": { "type": "integer", "description": "Статус карты" },
          "modifiedDate": { "type": "string", "description": "Дата последнего изменения" },
          "qrData": { "type": "string", "description": "Нефинансовый идентификатор карты" },
          "connectType": { "type": "string", "description": "Тип регистрации" },
          "comment": { "type": "string", "description": "Комментарий" },
          "integrationStatus": { "$ref": "#/components/schemas/IntegrationStatusResponce" }
        }
      },
      "SaveSettingsRequest": {
        "type": "object",
        "description": "Актуализируемые учетные данные",
        "properties": {
          "phone": { "type": "string", "description": "Номер телефона" },
          "mobilePhone": { "type": "string", "description": "Номер мобильного телефона" },
          "email": { "type": "string", "description": "Адрес электронной почты" },
          "emailAccept": { "type": "boolean", "description": "Флаг «Согласие на получение уведомлений»" }
        }
      },
      "TransferConsentRequest": {
        "type": "object",
        "description": "Запрос на получение согласия на передачу данных",
        "properties": {
          "birthDate": {
            "type": "string",
            "description": "Дата рождения (ДД.ММ.ГГГГ)",
            "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$"
          },
          "snils": { "type": "string", "description": "СНИЛС" },
          "transferConsent": { "type": "boolean", "description": "Согласие на передачу данных" }
        }
      },
      "ReaderStatusResponse": {
        "type": "object",
        "description": "Статус читательского билета",
        "properties": {
          "card": { "$ref": "#/components/schemas/BisCardInfo" },
          "status": { "type": "integer", "description": "Статус читательского билета" },
          "dateOfFinish": { "type": "string", "description": "Срок действия читательского билета" }
        }
      },
      "BisCardInfo": {
        "type": "object",
        "description": "Данные карты в сервисе читательского билета",
        "properties": {
          "bskNum": { "type": "string", "description": "Хэшированный номер карты" },
          "lastNumbers": { "type": "string", "description": "Последние четыре цифры карты" }
        }
      }
    }
  }
}
